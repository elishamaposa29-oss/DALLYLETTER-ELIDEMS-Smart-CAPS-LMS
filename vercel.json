{
  "$schema": "https://openapi.vercel.com/v1/schema.json",
  "framework": "vite",
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm --dir artifacts/dallyletter build",
  "outputDirectory": "artifacts/dallyletter/dist/public",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/about",
      "destination": "/about/index.html"
    },
    {
      "source": "/learners",
      "destination": "/learners/index.html"
    },
    {
      "source": "/educators",
      "destination": "/educators/index.html"
    },
    {
      "source": "/schools",
      "destination": "/schools/index.html"
    },
    {
      "source": "/organisations",
      "destination": "/organisations/index.html"
    },
    {
      "source": "/resources",
      "destination": "/resources/index.html"
    },
    {
      "source": "/resources/study-plan",
      "destination": "/resources/study-plan/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
