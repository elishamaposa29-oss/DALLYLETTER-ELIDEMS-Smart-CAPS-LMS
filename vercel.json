{
  "$schema": "https://openapi.vercel.com/v1/schema.json",
  "framework": "vite",
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm --dir artifacts/dallyletter build",
  "outputDirectory": "artifacts/dallyletter/dist/public",
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/social/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, stale-while-revalidate=86400"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "destination": "/public-site/index.html"
    },
    {
      "source": "/about/",
      "destination": "/about/index.html"
    },
    {
      "source": "/how-it-works/",
      "destination": "/how-it-works/index.html"
    },
    {
      "source": "/learners/",
      "destination": "/learners/index.html"
    },
    {
      "source": "/educators/",
      "destination": "/educators/index.html"
    },
    {
      "source": "/schools/",
      "destination": "/schools/index.html"
    },
    {
      "source": "/organisations/",
      "destination": "/organisations/index.html"
    },
    {
      "source": "/zimbabwe/",
      "destination": "/zimbabwe/index.html"
    },
    {
      "source": "/south-africa/",
      "destination": "/south-africa/index.html"
    },
    {
      "source": "/africa/",
      "destination": "/africa/index.html"
    },
    {
      "source": "/global-learning/",
      "destination": "/global-learning/index.html"
    },
    {
      "source": "/primary-learning/",
      "destination": "/primary-learning/index.html"
    },
    {
      "source": "/secondary-learning/",
      "destination": "/secondary-learning/index.html"
    },
    {
      "source": "/syllabus-support/",
      "destination": "/syllabus-support/index.html"
    },
    {
      "source": "/managers/",
      "destination": "/managers/index.html"
    },
    {
      "source": "/past-papers/",
      "destination": "/past-papers/index.html"
    },
    {
      "source": "/o-level/",
      "destination": "/o-level/index.html"
    },
    {
      "source": "/exam-preparation/",
      "destination": "/exam-preparation/index.html"
    },
    {
      "source": "/mathematics/",
      "destination": "/mathematics/index.html"
    },
    {
      "source": "/english/",
      "destination": "/english/index.html"
    },
    {
      "source": "/science/",
      "destination": "/science/index.html"
    },
    {
      "source": "/biology/",
      "destination": "/biology/index.html"
    },
    {
      "source": "/chemistry/",
      "destination": "/chemistry/index.html"
    },
    {
      "source": "/physics/",
      "destination": "/physics/index.html"
    },
    {
      "source": "/geography/",
      "destination": "/geography/index.html"
    },
    {
      "source": "/history/",
      "destination": "/history/index.html"
    },
    {
      "source": "/computer-studies/",
      "destination": "/computer-studies/index.html"
    },
    {
      "source": "/business-studies/",
      "destination": "/business-studies/index.html"
    },
    {
      "source": "/accounting/",
      "destination": "/accounting/index.html"
    },
    {
      "source": "/study-notes/",
      "destination": "/study-notes/index.html"
    },
    {
      "source": "/video-learning/",
      "destination": "/video-learning/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "trailingSlash": true
}
