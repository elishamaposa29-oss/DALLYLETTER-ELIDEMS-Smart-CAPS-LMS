{
  "expo": {
    "name": "DallyLetter Elidems",
    "slug": "dallyletter-mobile",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "dallyletter",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0d0d73"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.dallyletter.elidems"
    },
    "android": {
      "package": "com.dallyletter.elidems",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "backgroundColor": "#0d0d73"
      }
    },
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-web-browser",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow DallyLetter Elidems to choose your profile photo."
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Allow DallyLetter Elidems to record voice messages."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#0d0d73",
          "defaultChannel": "dallyletter-updates"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "6ca34097-f8a9-444f-beb9-b087569fb7a1"
      }
    }
  }
}