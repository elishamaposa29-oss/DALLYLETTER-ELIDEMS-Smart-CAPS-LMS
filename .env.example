# Common runtime config
NODE_ENV=development
PORT=4000
API_PORT=4000
API_BASE_URL=http://localhost:4000
BASE_PATH=/

# Database (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/dallyletter

# Authentication
