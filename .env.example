# Common runtime config
NODE_ENV=development
PORT=4000
API_PORT=4000
API_BASE_URL=http://localhost:4000
BASE_PATH=/

# Database (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/dallyletter

# Authentication
JWT_SECRET=dallyletter-local-secret

# Frontend and mobile integration
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
VITE_API_BASE_URL=http://localhost:4000
VITE_APP_NAME=DALLYLETTER ELIDEMS
EXPO_PUBLIC_API_URL=http://localhost:4000

# Optional AI providers
OPENAI_API_KEY=
GEMINI_API_KEY=

# Optional payment provider configuration
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
