# Common runtime config
NODE_ENV=development
PORT=4000
API_PORT=4000
API_BASE_URL=http://localhost:4000
BASE_PATH=/

# Database (PostgreSQL)
DATABASE_URL=

# Authentication
JWT_SECRET=

# Frontend and mobile integration
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
VITE_API_BASE_URL=
VITE_APP_NAME=
EXPO_PUBLIC_API_URL=

# Optional AI providers
OPENAI_API_KEY=
GEMINI_API_KEY=

# Optional payment provider configuration
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Durable media storage (optional locally; required for production uploads)
MEDIA_S3_ENDPOINT=
MEDIA_S3_BUCKET=
MEDIA_S3_ACCESS_KEY_ID=
MEDIA_S3_SECRET_ACCESS_KEY=
MEDIA_S3_REGION=auto

# Web Push (optional)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# Paynow (required only when live checkout is enabled)
PAYNOW_INTEGRATION_ID=
PAYNOW_INTEGRATION_KEY=
PUBLIC_APP_URL=
PUBLIC_API_URL=
