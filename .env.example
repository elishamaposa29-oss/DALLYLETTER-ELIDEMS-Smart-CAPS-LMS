# Common runtime config
NODE_ENV=development
PORT=4000
API_PORT=4000
API_BASE_URL=http://localhost:4000
BASE_PATH=/

# Database (PostgreSQL)
DATABASE_URL=

# Authentication
JWT_SECRET=
# Google Identity Services: same OAuth Web client ID in API and web build
GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=

# Frontend and mobile integration
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
VITE_API_BASE_URL=
VITE_APP_NAME=
EXPO_PUBLIC_API_URL=

# Transactional email (server-side only; never expose RESEND_API_KEY in a VITE_/EXPO_PUBLIC_ variable)
RESEND_API_KEY=
EMAIL_FROM=
# Optional Twilio SMS for verified phone contacts and urgent account notifications
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Optional approved Twilio WhatsApp sender, e.g. whatsapp:+14155238886 (configure only with an authorized sender)
TWILIO_WHATSAPP_FROM=

# Optional AI providers (server-side only; never expose keys in VITE_/EXPO_PUBLIC_ variables)
# Optional explicit provider: mock, gemini, openai, or anthropic
AI_PROVIDER=
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Optional payment provider configuration
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Durable media storage (optional locally; required for production uploads)
MEDIA_S3_ENDPOINT=
MEDIA_S3_BUCKET=
MEDIA_S3_ACCESS_KEY_ID=
MEDIA_S3_SECRET_ACCESS_KEY=
MEDIA_S3_REGION=auto

# Web Push (optional)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# Paynow (required only when live checkout is enabled)
PAYNOW_INTEGRATION_ID=
PAYNOW_INTEGRATION_KEY=
PUBLIC_APP_URL=
PUBLIC_API_URL=
